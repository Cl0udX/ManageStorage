{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/ARCHITECTURE.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "./ms test": "allow",
      "./ms db *": "allow",
      "./ms backup": "allow",
      "npm test": "allow",
      "systemctl --user status *": "allow",
      "systemctl --user restart manage-storage": "allow",
      "journalctl --user *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "sudo *": "ask",
      "systemctl restart caddy": "ask",
      "rm -rf *": "deny"
    }
  }
}
