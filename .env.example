# ManageStorage — configuración. Copia este archivo a ".env" y cambia lo que necesites:   cp .env.example .env
# ".env" NO se sube al repositorio (está en .gitignore). Una línea por variable; los comentarios van en líneas aparte.
# Todo es opcional: si falta una variable se usa el valor por defecto que aparece aquí.

# ───────── Identidad de la app (lo que ve la gente) ─────────
# Nombre completo (pantalla de login, título, nombre al instalarla) y nombre corto (debajo del ícono, máx. ~12 letras).
APP_NAME=Inventario
APP_SHORT_NAME=Inventario
# Color principal (barra del sistema y color de la app instalada). Formato #rrggbb.
THEME_COLOR=#14532d

# ───────── Región ─────────
# Zona horaria del NEGOCIO (nombre IANA: America/Bogota, America/Mexico_City, Europe/Madrid, UTC…).
# La usan: la validación de hora de los equipos, los respaldos y el reloj del servidor.
# También se puede cambiar después sin editar archivos:  ./ms node scripts/admin.js set-timezone <zona>
TIMEZONE=UTC
# Idioma/región para fechas y números (es-CO, es-MX, es-ES, en-US…) y moneda (código ISO: COP, MXN, EUR, USD…).
# Los importes son números ENTEROS en la unidad principal de la moneda (no se manejan centavos).
LOCALE=es
CURRENCY=USD

# ───────── Datos iniciales (scripts de administración) ─────────
# Nombre de la organización/negocio y usuario dueño que crea "./ms seed". La contraseña NO va aquí: se genera al azar y se
# muestra una sola vez.
ORG_NAME=Mi Negocio
OWNER_USERNAME=admin

# ───────── Servidor ─────────
# Escucha solo en esta dirección/puerto; el acceso público va por un proxy con HTTPS (ver "./ms caddy").
HOST=127.0.0.1
PORT=8095
# Archivo de la base de datos SQLite (relativo a esta carpeta o ruta absoluta).
DB_PATH=./data/app.db
# 1 si hay un proxy delante (Caddy/nginx) que pone la IP real en X-Forwarded-For. 0 si se expone directo (no recomendado).
TRUST_PROXY=1
# Intentos de inicio de sesión por IP cada 5 minutos.
LOGIN_MAX_ATTEMPTS=10
# on/off. Ubicación aproximada de cada equipo según su IP (consulta un servicio externo enviando SOLO la IP).
GEO_LOOKUP=on

# ───────── Publicación ─────────
# Dominio público (solo lo usa "./ms caddy" para generar la configuración del proxy).
DOMAIN=inventario.example.com
# Nombre del servicio de systemd que crea "./ms install" (permite varias instalaciones en el mismo servidor).
SERVICE_NAME=manage-storage

# ───────── Respaldos ─────────
# Carpeta (FUERA del proyecto), cuántos respaldos diarios conservar y a qué hora (hora del negocio, HH:MM) se hacen.
# "~" es tu carpeta personal.
BACKUP_DIR=~/ManageStorage-backups
BACKUP_KEEP=30
BACKUP_TIME=23:55
